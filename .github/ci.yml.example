# GitHub Actions workflow for this project.
#
# It is checked in here rather than at .github/workflows/ci.yml because the
# session that created this repository could not push workflow files. To
# enable CI, move it into place and commit:
#
#     mkdir -p .github/workflows
#     git mv .github/ci.yml.example .github/workflows/ci.yml
#     git commit -m 'Enable CI'

name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        python-version: ["3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: pip install -e ".[dev]"
      - run: python -m pytest

  test-without-pillow:
    # The converter must work with no third-party packages installed at all.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install -e . pytest
      - run: python -m pytest
